# CurseForge / BigWigs packager: what goes into the release zip
package-as: Tessera

ignore:
    - tools
    - docs
    - .github
    - .luacheckrc
    - .pkgmeta

# CurseForge and GitHub release notes: our own changelog rather than the commit list
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown
