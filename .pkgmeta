# CurseForge / BigWigs packager: what goes into the release zip
package-as: Tessera

ignore:
    - tools
    - docs
    - .github
    - .luacheckrc
    - .pkgmeta
    - .gitignore
    - RELEASE_NOTES.md
    - CLAUDE.md
    - ACR.md
    - AI-DECLARATION.md

# CurseForge and GitHub release notes: the section of CHANGELOG.md for the version being
# released, written to RELEASE_NOTES.md by the release workflow
manual-changelog:
    filename: RELEASE_NOTES.md
    markup-type: markdown
